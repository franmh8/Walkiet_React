{
  "expo": {
    "name": "C5i Hidalgo Walkie-Talkie",
    "slug": "c5i-hidalgo-walkiet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.c5i.hidalgo.walkiet",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Esta app requiere acceso al micrófono para la transmisión táctica de radio PTT."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090d16"
      },
      "package": "com.c5i.hidalgo.walkiet",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
