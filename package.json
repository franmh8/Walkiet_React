{
  "name": "c5i-hidalgo-walkiet",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build",
    "start": "node server.ts",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "expo": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "postinstall": "node -e \"const fs=require('fs'); const p='./node_modules/react-native/rn-get-polyfills.js'; if(fs.existsSync('./node_modules/react-native') && !fs.existsSync(p)){fs.writeFileSync(p, \\\"module.exports = require('@react-native/js-polyfills');\\\\n\\\");} const vc='./node_modules/react-native/Libraries/Core/ReactNativeVersionCheck.js'; if(fs.existsSync(vc)){fs.writeFileSync(vc, \\\"export function checkVersions(){}\\\\n\\\");}\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/js-polyfills": "^0.88.0",
    "cors": "^2.8.6",
    "expo": "^57.0.31",
    "expo-status-bar": "^58.0.3",
    "express": "^5.3.0",
    "lucide-react": "^0.460.0",
    "mysql2": "^3.24.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.88.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
